<Project Sdk="Microsoft.NET.Sdk">

  <!-- One source, two builds: net9.0 for Jellyfin 10.11, net10.0 for Jellyfin 12.x. -->
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.EpgStation</RootNamespace>
    <!-- Release version; the 4th field is the Jellyfin line (11 = 10.11, 12 = 12.x), so a 12.x
         server, which also accepts 10.11 builds, always picks the higher 12 build. -->
    <PluginVersion>0.1.1</PluginVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>Recommended</AnalysisMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007</NoWarn>
  </PropertyGroup>

  <!-- Build against the FIRST release of each Jellyfin line: Jellyfin refuses a plugin that
       references newer shared libraries than its own ("incompatible version ... Disabling plugin";
       0.1.0 built against 12.2.0 did not load on 12.1). Newer servers accept older references. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <JellyfinVersion>10.11.0</JellyfinVersion>
    <TargetAbi>10.11.0.0</TargetAbi>
    <AssemblyVersion>$(PluginVersion).11</AssemblyVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <JellyfinVersion>12.0.0</JellyfinVersion>
    <TargetAbi>12.0.0.0</TargetAbi>
    <AssemblyVersion>$(PluginVersion).12</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup>
    <FileVersion>$(AssemblyVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\**\*" />
  </ItemGroup>

</Project>
